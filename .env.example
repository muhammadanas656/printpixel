# Supabase Configuration for ProofPixel Contact Form
# 1. Project URL from: Supabase Dashboard -> Project Settings -> API -> Project URL
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Anon Key from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
