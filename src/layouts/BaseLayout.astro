---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "PrintPixel — Free, private in-browser image DPI and print size analyzer." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} — PrintPixel</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F3F4F1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0D1014" media="(prefers-color-scheme: dark)">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23C2205B' stroke-width='2.5'/%3E%3Cpath d='M16 1v8M16 23v8M1 16h8M23 16h8' stroke='%23C2205B' stroke-width='2.5'/%3E%3Ccircle cx='16' cy='16' r='3' fill='%23C2205B'/%3E%3C/svg%3E">
<script is:inline>(function(){try{var t=localStorage.getItem('ppi-theme');if(!t)t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t;}catch(e){}})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{
  --bg:#F3F4F1; --surface:#FFFFFF; --surface2:#F7F8F5;
  --ink:#171A1F; --ink2:#3C434D; --mut:#68717E;
  --line:#E3E5E0; --line2:#CFD3CB;
  --accent:#C2205B; --accent-hover:#A61B4E; --accent-soft:#FBE9F0;
  --ok:#157A46; --ok-soft:#E4F3EA;
  --warn:#96660A; --warn-soft:#FAF1DA;
  --bad:#B42318; --bad-soft:#FBEAE7; --bad-line:#EFC7C1;
  --draft:#5D6675; --draft-soft:#ECEEF1;
  --dot:rgba(23,26,31,.055);
  --shadow:0 1px 2px rgba(20,22,26,.05),0 10px 28px -14px rgba(20,22,26,.14);
  --shadow-sm:0 1px 2px rgba(20,22,26,.06);
  --disp:'Bricolage Grotesque',sans-serif; --body:'IBM Plex Sans',sans-serif; --mono:'IBM Plex Mono',monospace;
}
:root[data-theme="dark"]{
  --bg:#0D1014; --surface:#151A20; --surface2:#1A2027;
  --ink:#E9EBEF; --ink2:#C6CBD3; --mut:#9AA4B2;
  --line:#272E38; --line2:#39424F;
  --accent:#F2568F; --accent-hover:#FF74A5; --accent-soft:rgba(242,86,143,.13);
  --ok:#3FC97F; --ok-soft:rgba(63,201,127,.13);
  --warn:#E3B355; --warn-soft:rgba(227,179,85,.13);
  --bad:#F0705F; --bad-soft:rgba(240,112,95,.13); --bad-line:rgba(240,112,95,.4);
  --draft:#93A0B4; --draft-soft:rgba(147,160,180,.14);
  --dot:rgba(255,255,255,.045);
  --shadow:0 1px 2px rgba(0,0,0,.4),0 14px 34px -16px rgba(0,0,0,.55);
  --shadow-sm:0 1px 2px rgba(0,0,0,.35);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
html,body{overflow-x:clip}
body{font-family:var(--body);background:var(--bg);color:var(--ink);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;transition:background .25s,color .25s}
body::before{content:"";position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(var(--dot) 1px,transparent 1.2px);background-size:20px 20px;
  -webkit-mask-image:linear-gradient(#000 0%,transparent 72%);mask-image:linear-gradient(#000 0%,transparent 72%)}
body::after{content:"";position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;
  background:url(/ink/grain.png) repeat;background-size:520px auto;mix-blend-mode:multiply;opacity:.5}
:root[data-theme="dark"] body::after{mix-blend-mode:screen;filter:invert(1);opacity:.06}
.wrap{max-width:880px;margin:0 auto;padding-left:20px;padding-right:20px;position:relative;z-index:1}
a{color:var(--accent);text-decoration:none;transition:color .15s}
a:hover{color:var(--accent-hover);text-decoration:underline}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}

/* header */
.site-head{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid var(--line);box-shadow:var(--shadow-sm);transition:background .25s,border-color .25s}
.site-head .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;height:56px}
.brand,
.brand:hover,
.brand:focus,
.brand:active{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
.brand svg{flex:none;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
.brand:hover svg,
.brand:active svg{transform:rotate(90deg)}
.brand-name{font-family:var(--disp);font-weight:700;font-size:15.5px;letter-spacing:-.01em;white-space:nowrap;color:var(--ink)}
.brand-name em{font-style:normal;color:var(--mut);font-family:var(--body);font-weight:500;font-size:13px}
.head-nav{display:flex;gap:18px;margin-left:auto;align-items:center}
.head-nav a{font-size:13.5px;font-weight:500;color:var(--mut);text-decoration:none}
.head-nav a:hover, .head-nav a.active{color:var(--ink)}
.icon-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);
  background:var(--surface);border-radius:10px;color:var(--ink2);transition:border-color .15s,transform .15s}
.icon-btn:hover{border-color:var(--line2);transform:translateY(-1px)}
:root[data-theme="light"] .ic-moon{display:none}
:root[data-theme="dark"] .ic-sun{display:none}

/* content typography */
.page-container{padding-top:44px;padding-bottom:64px}
.page-header{margin-bottom:34px}
.eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:10px}
h1{font-family:var(--disp);font-weight:800;font-size:clamp(1.9rem,4vw,2.5rem);line-height:1.15;letter-spacing:-.022em;margin-bottom:12px}
.sub{color:var(--ink2);font-size:16px;max-width:64ch}
.prose{background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-sm);padding:36px 38px}
.prose h2{font-family:var(--disp);font-size:1.35rem;font-weight:700;letter-spacing:-.015em;margin:28px 0 10px;color:var(--ink)}
.prose h2:first-child{margin-top:0}
.prose h3{font-family:var(--disp);font-size:1.1rem;font-weight:700;margin:20px 0 8px}
.prose p{color:var(--ink2);margin-bottom:16px;line-height:1.65;font-size:15px}
.prose ul, .prose ol{margin:0 0 18px 22px;color:var(--ink2);font-size:15px}
.prose li{margin-bottom:8px;line-height:1.6}
.prose code{font-family:var(--mono);font-size:13px;background:var(--surface2);border:1px solid var(--line);padding:2px 6px;border-radius:5px;color:var(--accent)}
.prose hr{border:0;border-top:1px solid var(--line);margin:32px 0}
.prose blockquote{border-left:3px solid var(--accent);background:var(--accent-soft);padding:14px 18px;border-radius:8px;margin:20px 0;font-size:14.5px;color:var(--ink2)}

/* forms */
.form-group{margin-bottom:18px}
.form-label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase;color:var(--mut)}
.form-input, .form-textarea{width:100%;border:1px solid var(--line);border-radius:9px;background:var(--surface2);padding:12px 14px;font-family:inherit;font-size:15px;color:var(--ink);transition:border-color .15s;outline:none}
.form-input:focus, .form-textarea:focus{border-color:var(--accent);background:var(--surface)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:9px;border:1px solid transparent;font-weight:600;font-size:14.5px;
  padding:12px 22px;transition:background .15s,transform .15s;cursor:pointer}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-hover);transform:translateY(-1px)}
.btn:active{transform:scale(.98)}

/* footer */
footer{border-top:1px solid var(--line);margin-top:70px;padding:32px 0 44px}
footer .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}
footer p{font-size:13px;color:var(--mut);max-width:48ch;line-height:1.55}
.f-brand{display:flex;align-items:center;gap:9px;font-family:var(--disp);font-weight:700;font-size:14.5px;color:var(--ink)}
.cmyk{display:inline-flex;gap:5px;margin-left:4px;vertical-align:middle}
.cmyk i{width:6px;height:6px;border-radius:50%;display:inline-block}
.cmyk i:nth-child(1){background:#00A5CE}.cmyk i:nth-child(2){background:#E93A8C}
.cmyk i:nth-child(3){background:#F2C200}.cmyk i:nth-child(4){background:#2B2B2B}
.footer-nav{display:flex;gap:18px;flex-wrap:wrap}
.footer-nav a{font-size:13px;color:var(--mut);text-decoration:none}
.footer-nav a:hover{color:var(--ink);text-decoration:underline}

@media(max-width:640px){
  .wrap{padding-left:16px;padding-right:16px}
  .page-container{padding-top:36px;padding-bottom:48px}
  .page-header{margin-bottom:26px}
  .prose{padding:24px 20px;border-radius:14px}
  .head-nav{display:none}
  .brand-name em{display:none}
  footer .wrap{flex-direction:column;gap:18px}
}
</style>
</head>
<body>

<header class="site-head" id="siteHead">
  <div class="wrap">
    <a class="brand" href="/" aria-label="PrintPixel home">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="9" stroke="var(--accent)" stroke-width="2.5"/>
        <path d="M16 1v8M16 23v8M1 16h8M23 16h8" stroke="var(--accent)" stroke-width="2.5"/>
        <circle cx="16" cy="16" r="3" fill="var(--accent)"/>
      </svg>
      <span class="brand-name">PrintPixel <em>· DPI &amp; Print Analyzer</em></span>
    </a>
    <nav class="head-nav" aria-label="Page sections">
      <a href="/">Analyzer</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
    <button class="icon-btn" id="themeBtn" aria-label="Switch color theme">
      <svg class="ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
      <svg class="ic-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8z"/></svg>
    </button>
  </div>
</header>

<div class="wrap page-container">
  <slot />
</div>

<footer>
  <div class="wrap">
    <div>
      <div class="f-brand">
        <svg width="17" height="17" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="9" stroke="var(--accent)" stroke-width="2.5"/><path d="M16 1v8M16 23v8M1 16h8M23 16h8" stroke="var(--accent)" stroke-width="2.5"/><circle cx="16" cy="16" r="3" fill="var(--accent)"/></svg>
        PrintPixel
        <span class="cmyk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </div>
      <p style="margin-top:9px">Your image is analyzed directly in your browser. No uploads, no accounts, no tracking of your files.</p>
    </div>
    <nav class="footer-nav" aria-label="Legal and information links">
      <a href="/">Analyzer</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </nav>
  </div>
</footer>

<script is:inline>
const themeBtn = document.getElementById('themeBtn');
if (themeBtn) {
  themeBtn.onclick = () => {
    const current = document.documentElement.dataset.theme;
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('ppi-theme', next); } catch(e) {}
  };
}
</script>

</body>
</html>
