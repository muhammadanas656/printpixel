<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
/* ================= tokens ================= */
:root{
  --bg:#F3F4F1; --surface:#FFFFFF; --surface2:#F7F8F5;
  --ink:#171A1F; --ink2:#3C434D; --mut:#68717E;
  --line:#E3E5E0; --line2:#CFD3CB;
  --accent:#C2205B; --accent-hover:#A61B4E; --accent-soft:#FBE9F0;
  --ok:#157A46; --ok-soft:#E4F3EA;
  --warn:#96660A; --warn-soft:#FAF1DA;
  --bad:#B42318; --bad-soft:#FBEAE7; --bad-line:#EFC7C1;
  --draft:#5D6675; --draft-soft:#ECEEF1;
  --dot:rgba(23,26,31,.055);
  --scrim:rgba(255,255,255,.30);
  --dz-scrim:rgba(247,248,245,.78);
  --photoO:.38;
  --shadow:0 1px 2px rgba(20,22,26,.05),0 10px 28px -14px rgba(20,22,26,.14);
  --shadow-sm:0 1px 2px rgba(20,22,26,.06);
  --disp:'Bricolage Grotesque',sans-serif; --body:'IBM Plex Sans',sans-serif; --mono:'IBM Plex Mono',monospace;
}
:root[data-theme="dark"]{
  --bg:#0D1014; --surface:#151A20; --surface2:#1A2027;
  --ink:#E9EBEF; --ink2:#C6CBD3; --mut:#9AA4B2;
  --line:#272E38; --line2:#39424F;
  --accent:#F2568F; --accent-hover:#FF74A5; --accent-soft:rgba(242,86,143,.13);
  --ok:#3FC97F; --ok-soft:rgba(63,201,127,.13);
  --warn:#E3B355; --warn-soft:rgba(227,179,85,.13);
  --bad:#F0705F; --bad-soft:rgba(240,112,95,.13); --bad-line:rgba(240,112,95,.4);
  --draft:#93A0B4; --draft-soft:rgba(147,160,180,.14);
  --dot:rgba(255,255,255,.045);
  --scrim:rgba(13,16,20,.45);
  --dz-scrim:rgba(21,26,32,.82);
  --photoO:.30;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 14px 34px -16px rgba(0,0,0,.55);
  --shadow-sm:0 1px 2px rgba(0,0,0,.35);
}
/* ================= base ================= */
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
html,body{overflow-x:clip}
body{font-family:var(--body);background:var(--bg);color:var(--ink);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;transition:background .25s,color .25s;
  -webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}
input,textarea{-webkit-user-select:auto;-moz-user-select:auto;-ms-user-select:auto;user-select:auto}
img{-webkit-user-drag:none;user-drag:none}
body::before{content:"";position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(var(--dot) 1px,transparent 1.2px);background-size:20px 20px;
  -webkit-mask-image:linear-gradient(#000 0%,transparent 72%);mask-image:linear-gradient(#000 0%,transparent 72%)}
body::after{content:"";position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;
  background:url(/ink/grain.png) repeat;background-size:520px auto;mix-blend-mode:multiply;opacity:.5}
:root[data-theme="dark"] body::after{mix-blend-mode:screen;filter:invert(1);opacity:.06}
.wrap{max-width:1060px;margin:0 auto;padding:0 20px;position:relative;z-index:1}
a{color:var(--accent)}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.mono{font-family:var(--mono)}

/* ============ SPOTLIGHT LAW ============
   Hovered / touched item brightens; siblings recede. Works on desktop hover & mobile touch. */
.dim-item{transition:opacity .25s ease,filter .25s ease,transform .2s ease}
.dim-group:has(> .dim-item:hover) > .dim-item:not(:hover),
.dim-group:has(> .dim-item:active) > .dim-item:not(:active),
.dim-group:has(> .dim-item.touch-active) > .dim-item:not(.touch-active){opacity:.55;filter:saturate(.8)}
.dim-group:has(> .dim-item:focus-within) > .dim-item:not(:focus-within):not(:hover):not(:active){opacity:.55}
.dim-item:active, .dim-item.touch-active{opacity:1!important;filter:none!important}

/* ================= header ================= */
.site-head{position:sticky;top:0;z-index:40;background:transparent;border-bottom:1px solid transparent;
  transition:background .25s,border-color .25s,box-shadow .25s}
.site-head.scrolled{background:var(--bg);border-bottom-color:var(--line);box-shadow:var(--shadow-sm)}
.site-head .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;height:58px;transition:height .25s}
.site-head.scrolled .wrap{height:52px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
.brand svg{flex:none;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
.brand:hover svg{transform:rotate(90deg)}
.brand-name{font-family:var(--disp);font-weight:700;font-size:15.5px;letter-spacing:-.01em;white-space:nowrap}
.brand-name em{font-style:normal;color:var(--mut);font-family:var(--body);font-weight:500;font-size:13px}
.head-nav{display:flex;gap:20px;margin-left:auto}
.head-nav a{font-size:13px;font-weight:500;color:var(--mut);text-decoration:none;transition:color .15s}
.head-nav a:hover{color:var(--ink)}
@media(max-width:768px){.head-nav{display:none}}
.icon-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);
  background:var(--surface);border-radius:10px;color:var(--ink2);transition:border-color .15s,transform .15s}
.icon-btn:hover{border-color:var(--line2);transform:translateY(-1px)}
:root[data-theme="light"] .ic-moon{display:none}
:root[data-theme="dark"] .ic-sun{display:none}

/* ================= intro ================= */
.intro{padding:34px 0 18px;position:relative}
.intro-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}
.proof{justify-self:end;width:100%;max-width:380px}
.proof-card{background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);
  padding:16px 18px;transform:rotate(-1.4deg);transition:transform .35s cubic-bezier(.2,.7,.2,1)}
.proof:hover .proof-card{transform:rotate(0deg) translateY(-2px)}
.proof-head{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
.proof-dot{width:7px;height:7px;border-radius:50%;background:var(--accent)}
.proof-stamp{margin-left:auto;color:var(--ok);border:1.5px solid var(--ok);border-radius:5px;padding:1px 6px;font-size:9px;letter-spacing:.12em;transform:rotate(4deg)}
.proof-file{font-size:13px;font-weight:600;margin:10px 0 8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.proof-line{display:flex;justify-content:space-between;gap:10px;font-family:var(--mono);font-size:12px;padding:6px 0;border-top:1px dashed var(--line)}
.proof-line .lbl{color:var(--mut)}
.proof-ladder{margin-top:10px;display:flex;flex-direction:column;gap:7px}
.pl{display:flex;align-items:center;gap:10px}
.pl .track{flex:1;height:7px;border-radius:4px;background:var(--surface2);border:1px solid var(--line);overflow:hidden}
.pl .track i{display:block;height:100%;border-radius:4px}
.pl>span:last-child{font-family:var(--mono);font-size:10.5px;color:var(--mut);white-space:nowrap}
.proof-note{margin-top:12px;font-size:12.5px;color:var(--ink2);background:var(--ok-soft);border-radius:8px;padding:8px 10px}
.proof-cap{margin-top:12px;text-align:center;font-family:var(--mono);font-size:10.5px;color:var(--mut)}
@media(max-width:1000px){.intro-grid{grid-template-columns:1fr}.proof{display:none}}
.eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:14px}
h1{font-family:var(--disp);font-weight:800;font-size:clamp(1.85rem,4.4vw,2.85rem);line-height:1.08;letter-spacing:-.022em;max-width:17ch}
.intro .sub{margin-top:14px;max-width:56ch;color:var(--ink2);font-size:clamp(.98rem,1.6vw,1.08rem)}
.model{display:flex;margin-top:22px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.model li{flex:1;list-style:none;padding:12px 18px 12px 0;display:flex;gap:10px;align-items:flex-start}
.model li+li{border-left:1px solid var(--line);padding-left:18px}
.model .n{font-family:var(--mono);font-size:10px;font-weight:600;color:var(--accent);border:1px solid var(--accent);
  border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;flex:none;margin-top:1px}
.model b{display:block;font-size:12.5px}
.model span{display:block;font-size:11.5px;color:var(--ink2);margin-top:1px}

/* ================= tool card ================= */
.tool{margin:34px 0 20px;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
.tabs{display:flex;border-bottom:1px solid var(--line);background:var(--surface2)}
.tab{flex:1;appearance:none;background:none;border:0;padding:15px 10px 13px;font-size:14px;font-weight:600;color:var(--mut);
  position:relative;display:flex;align-items:center;justify-content:center;gap:9px;transition:color .15s}
.tab:hover{color:var(--ink2)}
.tab[aria-selected="true"]{color:var(--ink)}
.tab::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--accent);transform:scaleX(0);transition:transform .2s}
.tab[aria-selected="true"]::after{transform:scaleX(1)}
.tab .idx{font-family:var(--mono);font-size:11px;color:var(--mut);font-weight:500}
.tab .hasimg{width:7px;height:7px;border-radius:50%;background:var(--ok);display:none;flex:none}
.tab .hasimg.on{display:block;animation:pop .3s ease}
@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}
.panel{padding:26px;display:none}
.panel.on{display:block;animation:fadeUp .3s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}

/* ---- dropzone ---- */
.dropzone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:100%;min-height:260px;
  border:1.5px dashed var(--line2);border-radius:12px;background:var(--surface2);text-align:center;padding:44px 20px;
  position:relative;overflow:hidden;transition:border-color .18s}
.dropzone:hover,.dropzone.drag{border-color:var(--accent)}
.dz-photo{position:absolute;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(var(--dz-scrim),var(--dz-scrim)),var(--img,none);
  background-size:cover,cover;background-position:center,center;
  -webkit-mask-image:radial-gradient(115% 95% at 50% 50%,#000 52%,transparent 98%);
          mask-image:radial-gradient(115% 95% at 50% 50%,#000 52%,transparent 98%);
  filter:saturate(.75) contrast(.92) blur(1.5px);
  opacity:0;transform:scale(1.04);transition:opacity .9s ease,transform 1.6s cubic-bezier(.2,.7,.2,1)}
.dropzone:hover .dz-photo,.dropzone.drag .dz-photo{opacity:1;transform:scale(1)}
.dropzone>*:not(.dz-photo){position:relative;z-index:1}
.dropzone .cm{position:absolute;z-index:1;width:15px;height:15px;border:0 solid var(--line2);transition:transform .2s,border-color .2s}
.cm.tl{top:10px;left:10px;border-top-width:2px;border-left-width:2px}
.cm.tr{top:10px;right:10px;border-top-width:2px;border-right-width:2px}
.cm.bl{bottom:10px;left:10px;border-bottom-width:2px;border-left-width:2px}
.cm.br{bottom:10px;right:10px;border-bottom-width:2px;border-right-width:2px}
.dropzone:hover .cm,.dropzone.drag .cm{border-color:var(--accent)}
.dropzone.drag .cm.tl{transform:translate(-3px,-3px)}.dropzone.drag .cm.tr{transform:translate(3px,-3px)}
.dropzone.drag .cm.bl{transform:translate(-3px,3px)}.dropzone.drag .cm.br{transform:translate(3px,3px)}
.dz-icon{color:var(--ink2);margin-bottom:8px}
.dz-title{font-family:var(--disp);font-size:1.3rem;font-weight:700;letter-spacing:-.015em}
.dz-sub{color:var(--ink2);font-size:13.5px}
.dz-sub-mob{display:none}
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:9px;border:1px solid transparent;font-weight:600;font-size:14px;
  padding:10px 18px;transition:background .15s,border-color .15s,transform .15s,box-shadow .2s;text-decoration:none;position:relative}
.btn:active, .icon-btn:active{transform:scale(.98)}
.btn-primary{background:var(--accent);color:#fff;margin-top:12px}
.btn-primary:hover{background:var(--accent-hover);transform:translateY(-1px);box-shadow:0 8px 20px -10px var(--accent)}
.btn-ghost{background:transparent;border-color:var(--line2);color:var(--ink)}
.btn-ghost:hover{border-color:var(--mut);background:var(--surface2)}
.btn-sm{padding:7px 13px;font-size:13px}

/* dropzone actions + expectation line */
.dz-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:12px}
.dz-actions .btn-primary{margin-top:0}
.dz-out{font-family:var(--mono);font-size:11px;color:var(--mut);margin-top:14px}

/* plain-English lead sentence in results */
.res-lead{display:flex;gap:10px;align-items:flex-start;background:var(--ok-soft);border-left:3px solid var(--ok);
  border-radius:8px;padding:12px 14px;font-size:14px;color:var(--ink2);margin-bottom:18px}
.res-lead b{color:var(--ink)}
.res-lead svg{flex:none;margin-top:2px;color:var(--ok)}

.dz-note{display:inline-flex;align-items:center;justify-content:center;gap:7px;margin-top:14px;font-family:var(--mono);font-size:11px;color:var(--ink2);letter-spacing:.02em;line-height:1.2}
.dz-note svg{flex:none;width:12px;height:12px;margin:0}
.cmyk{display:inline-flex;gap:5px;margin-left:4px;vertical-align:middle}
.cmyk i{width:6px;height:6px;border-radius:50%;display:inline-block}
.cmyk i:nth-child(1){background:#00A5CE}.cmyk i:nth-child(2){background:#E93A8C}
.cmyk i:nth-child(3){background:#F2C200}.cmyk i:nth-child(4){background:#2B2B2B}
.err{margin-top:14px;display:flex;gap:10px;align-items:flex-start;background:var(--bad-soft);border:1px solid var(--bad-line);
  color:var(--bad);border-radius:10px;padding:12px 14px;font-size:13.5px;animation:fadeUp .25s ease}
.err svg{flex:none;margin-top:1px}

/* ---- analyze results ---- */
.res-head{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px}
.thumb{width:56px;height:56px;border-radius:10px;object-fit:cover;border:1px solid var(--line);background:var(--surface2);flex:none}
.res-file{min-width:0;flex:1}
.res-file b{display:block;font-size:14.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:46ch}
.res-file span{font-family:var(--mono);font-size:11.5px;color:var(--mut)}
.res-actions{display:flex;gap:8px}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.stat{background:var(--surface);padding:15px 16px;display:flex;flex-direction:column;justify-content:center}
.stat .lbl{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin-bottom:6px}
.stat .val{font-family:var(--mono);font-size:clamp(14px,2vw,19px);font-weight:600;letter-spacing:-.01em;line-height:1.2}
.stat .val.big{font-size:clamp(17px,2.4vw,24px)}
.stat .sub{font-size:11.5px;color:var(--mut);margin-top:3px}
.stat-dpi{align-items:center;text-align:center}
.stat-dpi .lbl{text-align:center;width:100%}
.stat-dpi .sub{text-align:center;width:100%}
.badge{display:inline-flex;align-items:center;justify-content:center;gap:6px;font-family:var(--mono);font-size:11.5px;font-weight:600;padding:4px 11px;border-radius:999px;margin-top:2px;line-height:1.2;text-align:center}
.badge svg{flex:none}
.badge.has{background:var(--ok-soft);color:var(--ok)}
.badge.none{background:var(--draft-soft);color:var(--draft)}
.ladder{margin-top:24px}
.ladder h3{font-family:var(--disp);font-size:1.02rem;font-weight:700;letter-spacing:-.01em;margin-bottom:4px}
.ladder .cap{font-size:12.5px;color:var(--mut);margin-bottom:10px}
.lrow{display:grid;grid-template-columns:172px 1fr auto;gap:14px;align-items:center;padding:11px 12px;border-radius:10px;transition:opacity .25s,filter .25s,background .15s}
.lrow:hover{background:var(--surface2)}
.lrow+.lrow{border-top:1px solid var(--line)}
.ltier{display:flex;flex-direction:column;gap:2px}
.ltier b{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:7px}
.ltier b::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--tc);flex:none}
.ltier span{font-family:var(--mono);font-size:11px;color:var(--mut)}
.lbar{height:9px;border-radius:5px;background:var(--surface2);border:1px solid var(--line);overflow:hidden}
.lbar i{display:block;height:100%;border-radius:5px;background:var(--tc);width:0;transition:width .7s cubic-bezier(.2,.7,.2,1)}
.lsize{text-align:right}
.lsize b{font-family:var(--mono);font-size:13.5px;font-weight:600;display:block;white-space:nowrap}
.lsize span{font-family:var(--mono);font-size:11px;color:var(--mut);white-space:nowrap}
.hintline{margin-top:14px;font-size:12.5px;color:var(--mut);font-family:var(--mono)}
.note{margin-top:18px;border-radius:10px;padding:13px 15px;font-size:13.5px;line-height:1.55;display:flex;gap:11px;align-items:flex-start}
.note svg{flex:none;margin-top:2px}
.note.info{background:var(--draft-soft);color:var(--ink2)}
.note.warn{background:var(--warn-soft);color:var(--ink2)}
.note b{color:var(--ink)}
.res-cta{margin-top:22px;padding-top:20px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.res-cta p{font-size:13.5px;color:var(--mut);max-width:44ch}

/* ---- plan ---- */
.plan-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:26px}
.field-lbl{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin-bottom:9px}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{border:1px solid var(--line);background:var(--surface);color:var(--ink2);font-size:12.5px;font-weight:500;
  padding:7px 13px;border-radius:999px;transition:opacity .25s,filter .25s,border-color .15s,background .15s,color .15s}
.chip:hover{border-color:var(--line2);color:var(--ink)}
.chip.sel{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.dim-group:has(> .dim-item:hover) > .dim-item:not(:hover):not(.sel){opacity:.55;filter:saturate(.8)}
.dim-row{display:flex;gap:10px;align-items:center;margin-top:14px;flex-wrap:wrap}
.dim-field{flex:1;min-width:90px;display:flex;align-items:center;border:1px solid var(--line);border-radius:9px;background:var(--surface);transition:border-color .15s}
.dim-field:focus-within{border-color:var(--accent)}
.dim-field input{border:0;background:none;width:100%;padding:10px 4px 10px 12px;font-family:var(--mono);font-size:15px;font-weight:600;color:var(--ink);outline:none}
.dim-field .unit{font-family:var(--mono);font-size:12px;color:var(--mut);padding:0 11px}
.dim-x{color:var(--mut);font-family:var(--mono);font-size:13px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:var(--surface)}
.seg button{border:0;background:none;padding:6px 12px;font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--mut);transition:background .15s,color .15s}
.seg button+button{border-left:1px solid var(--line)}
.seg button.sel{background:var(--ink);color:var(--bg)}
.qgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.qopt{position:relative;z-index:0;overflow:hidden;border:1px solid var(--line);background:var(--surface);border-radius:10px;
  padding:11px 12px;text-align:left;transition:opacity .25s,filter .25s,border-color .15s}
.qopt:hover{border-color:var(--line2)}
.qopt.sel{border-color:var(--accent)}
.qopt::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(var(--scrim),var(--scrim)),var(--img,none) center/cover;
  opacity:.12;transition:opacity .5s ease}
.qopt:hover::before, .qopt:active::before, .qopt.touch-active::before, .qopt.sel::before{opacity:.42}
.qopt[data-tier="300"]::before{filter:blur(0)}
.qopt[data-tier="150"]::before{filter:blur(1.1px) saturate(.9)}
.qopt[data-tier="72"]::before{filter:blur(2.6px) saturate(.75)}
.qopt b{font-family:var(--mono);font-size:14px;font-weight:600;display:block;position:relative}
.qopt span{font-size:11.5px;color:var(--ink2);display:block;margin-top:2px;line-height:1.4;position:relative}
.plan-out{border:1px solid var(--line);border-radius:12px;background:var(--surface2);padding:18px}
.plan-out .lbl{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
.plan-out .need{font-family:var(--mono);font-size:clamp(18px,2.6vw,25px);font-weight:600;letter-spacing:-.01em;margin:7px 0 3px}
.plan-out .need small{font-size:.62em;color:var(--mut);font-weight:500}
.plan-out .meta{font-size:12.5px;color:var(--mut)}
.verdict{margin-top:16px;border-radius:12px;border:1px solid var(--line);border-left:4px solid var(--tone,var(--mut));padding:16px 17px;background:var(--surface);position:relative}
.verdict .v-head{display:flex;align-items:center;gap:9px;font-family:var(--disp);font-weight:700;font-size:15.5px;letter-spacing:-.01em;color:var(--tone);padding-right:96px}
.verdict .v-body{font-size:13.5px;color:var(--ink2);margin-top:7px;line-height:1.55}
.verdict .v-sub{font-family:var(--mono);font-size:11.5px;color:var(--mut);margin-top:9px}
.stamp{position:absolute;top:12px;right:14px;padding:4px 10px;border:2px solid var(--tone);outline:1px solid var(--tone);
  outline-offset:2px;border-radius:6px;color:var(--tone);font-family:var(--mono);font-size:10.5px;font-weight:600;
  letter-spacing:.14em;transform:rotate(-7deg);animation:stampIn .5s cubic-bezier(.2,1.4,.4,1) .25s both}
@keyframes stampIn{0%{opacity:0;transform:rotate(-7deg) scale(2)}70%{opacity:1;transform:rotate(-7deg) scale(.94)}100%{opacity:.92;transform:rotate(-7deg) scale(1)}}
.gauge{margin-top:13px;height:10px;border-radius:6px;background:var(--surface2);border:1px solid var(--line);position:relative;overflow:hidden}
.gauge i{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--tone);border-radius:6px;transition:width .7s cubic-bezier(.2,.7,.2,1)}
.gauge .mk{position:absolute;top:-3px;bottom:-3px;width:2px;background:var(--line2)}
.gauge-lbls{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--mut);margin-top:5px}
.imgchip{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin-top:16px;background:var(--surface);font-size:13px}
.imgchip b{font-weight:600}
.imgchip .mono{font-size:11.5px;color:var(--mut)}
.imgchip .chg{margin-left:auto;background:none;border:0;color:var(--accent);font-size:12.5px;font-weight:600;text-decoration:underline;text-underline-offset:3px}
.noimg{margin-top:16px;border:1.5px dashed var(--line2);border-radius:12px;padding:22px;text-align:center;color:var(--mut);font-size:13.5px}
.noimg .btn{margin-top:12px}
.disclaim{margin-top:14px;font-size:11.5px;color:var(--mut);line-height:1.5}

/* ================= sections ================= */
section.block{margin:64px 0}
section.block h2{font-family:var(--disp);font-weight:700;font-size:clamp(1.3rem,2.6vw,1.7rem);letter-spacing:-.018em;position:relative;display:inline-block}
section.block h2::after{content:"";position:absolute;left:0;right:0;bottom:-7px;height:2px;background:var(--accent);
  transform:scaleX(0);transform-origin:left center;transition:transform .6s cubic-bezier(.2,.7,.2,1) .1s}
section.block h2.rev::after{transform:scaleX(1)}
.sec-head{margin-top:14px}
.sec-head .k{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.14em;color:var(--accent)}
section.block .lede{color:var(--mut);font-size:14px;margin:8px 0 22px;max-width:62ch}
.table-card{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface);box-shadow:var(--shadow-sm)}
.tbl-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:560px}
th{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);text-align:left;
  padding:12px 18px;border-bottom:1px solid var(--line);background:var(--surface2);font-weight:500;white-space:nowrap}
td{padding:12px 18px;border-bottom:1px solid var(--line);font-size:13.5px;white-space:nowrap}
tbody tr:last-child td{border-bottom:0}
tbody tr{transition:opacity .25s,filter .25s,background .15s}
tbody tr:hover{background:var(--surface2)}
td.size{font-weight:600}
td.px{font-family:var(--mono);font-size:12.5px;color:var(--ink2)}
td.px small{display:block;color:var(--mut);font-size:10.5px;margin-top:1px}
.use-btn{border:1px solid var(--line);background:var(--surface);border-radius:7px;font-size:12px;font-weight:600;padding:5px 11px;color:var(--ink2);transition:all .15s}
.use-btn:hover{border-color:var(--accent);color:var(--accent)}

/* ================= FAQ: cursor spotlight across question & answer ================= */
.acc{border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow-sm);overflow:hidden}
.acc-item{position:relative;z-index:0;border-bottom:1px solid var(--line);overflow:hidden}
.acc-item:last-child{border-bottom:0}
.acc-btn{width:100%;display:flex;align-items:center;background:none;border:0;text-align:left;position:relative;z-index:1;
  padding:18px 20px;font-family:var(--disp);font-size:15.5px;font-weight:700;letter-spacing:-.01em;color:var(--ink);transition:background .15s}
.acc-btn .qn{font-family:var(--mono);font-size:11px;font-weight:500;color:var(--mut);margin-right:14px;flex:none;position:relative}
.acc-btn .pm{margin-left:auto;flex:none;width:22px;height:22px;display:flex;align-items:center;justify-content:center;color:var(--mut);transition:transform .25s;position:relative}
.acc-item.open .pm{transform:rotate(45deg)}
.acc-body{overflow:hidden;max-height:0;transition:max-height .35s ease;position:relative;z-index:1}
.acc-body p{padding:2px 56px 20px 52px;font-size:14px;color:var(--ink2);max-width:72ch;line-height:1.6}
.acc-body p em{font-style:normal;color:var(--accent);font-weight:600}
/* Photo layer with cursor spotlight mask across entire question + answer (Q3 method) */
.acc-item::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(var(--scrim),var(--scrim)),var(--img,none) center/cover;
  opacity:0;transition:opacity .35s ease;
  -webkit-mask-image:radial-gradient(250px circle at var(--mx,50%) var(--my,50%),#000 35%,transparent 72%);
  mask-image:radial-gradient(250px circle at var(--mx,50%) var(--my,50%),#000 35%,transparent 72%)}
.acc-item:hover::before, .acc-item:active::before, .acc-item.touch-active::before, .acc-item.open::before{opacity:var(--photoO)}

/* ================= footer ================= */
footer{border-top:1px solid var(--line);margin-top:70px;padding:30px 0 44px}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:flex-start}
footer p{font-size:12.5px;color:var(--mut);max-width:52ch}
.f-brand{display:flex;align-items:center;gap:9px;font-family:var(--disp);font-weight:700;font-size:14px}
.f-brand .cmyk{margin-left:4px}
.footer-nav{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-top:12px}
.footer-nav a{font-size:12.5px;color:var(--mut);text-decoration:none;transition:color .15s}
.footer-nav a:hover{color:var(--ink);text-decoration:underline}

/* ================= responsive / motion / touch ================= */
@media(max-width:860px){
  .plan-grid{grid-template-columns:1fr}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
  .model{flex-direction:column}
  .model li+li{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:10px}
}
/* ================= MOBILE QUALITY PASS ================= */
@media(max-width:768px){
  .head-nav{display:none}
}
@media(max-width:640px){
  .wrap{padding:0 16px}
  .site-head .wrap{height:52px}
  .brand-name em{display:none}                 /* kills 320px overflow */
  .brand-name{font-size:15px}

  .intro{padding:26px 0 14px}
  .intro-grid{gap:0}
  h1{font-size:clamp(1.7rem,7.5vw,2.2rem)}
  .intro .sub{font-size:15px}
  .model{margin-top:18px}
  .model li{padding:10px 0}
  .model b{font-size:12px}
  .model span{font-size:11px}

  .tool{margin:26px 0 16px}
  .panel{padding:16px}
  .tabs .idx{display:none}
  .tab{font-size:13px;padding:13px 6px 11px;gap:6px;min-height:48px}

  .dropzone{min-height:220px;padding:28px 16px;border-radius:14px}
  .dropzone:active{border-color:var(--accent)}
  .dz-sub-desk{display:none}
  .dz-sub-mob{display:inline}
  .dz-actions{flex-direction:column;align-items:stretch;width:100%;max-width:320px;gap:10px;margin-top:14px}
  .dz-actions .btn{min-height:48px;justify-content:center;font-size:14.5px;padding:12px 18px}
  .dz-out{font-size:10.5px;line-height:1.5;max-width:34ch;margin-top:12px}
  .dz-note{font-size:10.5px;line-height:1.6;margin-top:12px}
  .btn{padding:12px 18px}                        /* proper touch targets */

  .res-head{display:grid;grid-template-columns:56px 1fr;grid-template-rows:auto auto;gap:12px 14px;align-items:center;margin-bottom:18px}
  .thumb{grid-column:1;grid-row:1;width:56px;height:56px;border-radius:10px}
  .res-file{grid-column:2;grid-row:1;min-width:0}
  .res-file b{font-size:15px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .res-actions{grid-column:1 / -1;grid-row:2;display:flex;gap:8px;width:100%}
  .res-actions .btn{flex:1;min-height:44px;justify-content:center;font-size:13.5px;padding:10px 14px}
  .res-actions .icon-btn{width:44px;height:44px;flex:none;border-radius:9px}

  .stat-grid{grid-template-columns:1fr 1fr}
  .stat{padding:12px 14px}
  .stat .val{font-size:13px}
  .stat .val.big{font-size:16px}
  .lrow{grid-template-columns:1fr;gap:9px;padding:13px 14px;background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:8px}
  .lrow+.lrow{border-top:1px solid var(--line)}
  .lsize{display:flex;justify-content:space-between;align-items:baseline;width:100%;padding-top:2px;text-align:left}
  .lsize b{font-size:13.5px;color:var(--ink)}
  .lsize span{font-size:11.5px;color:var(--mut)}
  .res-cta{flex-direction:column;align-items:stretch;gap:14px;margin-top:20px;padding-top:18px;text-align:center}
  .res-cta p{font-size:13.5px;max-width:100%;line-height:1.5}
  .res-cta .btn{min-height:48px;justify-content:center;font-size:15px;font-weight:600}

  .dim-field input{font-size:16px}               /* stops iOS focus-zoom */
  input[type=number]::-webkit-outer-spin-button,
  input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  input[type=number]{-moz-appearance:textfield}

  .stamp{position:static;display:inline-block;margin-bottom:10px;transform:rotate(-3deg)}
  .verdict{padding:14px}
  .verdict .v-head{padding-right:0;flex-wrap:wrap}
  .gauge-lbls{font-size:9px}

  .imgchip div{min-width:0}
  .imgchip b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:22ch}

  .acc-btn{padding:15px 16px;font-size:14.5px}
  .acc-btn .qn{margin-right:10px}
  .acc-body p{padding:0 16px 18px 16px}

  .table-card{position:relative}
  .table-card::after{content:"";position:absolute;top:0;right:0;bottom:0;width:26px;
    background:linear-gradient(to left,var(--surface),transparent);pointer-events:none}

  footer .wrap{flex-direction:column;gap:16px}
}
@media(max-width:480px){
  .dim-row{display:grid;grid-template-columns:1fr auto 1fr auto;align-items:center;gap:8px}
  .dim-field{min-width:0}
  .seg{grid-column:1 / -1;justify-self:start}
  .qopt{padding:14px}
  .dz-title{font-size:1.15rem}
}
@media(max-width:380px){
  .brand-name{font-size:14px}
  .tab{font-size:12.5px}
  .stat .val.big{font-size:15px}
  .stamp{font-size:8.5px;padding:2px 6px}
}
@media(hover:none){
  .dz-photo{opacity:1;transform:none}
  .qopt::before{opacity:.18}
  .qopt.sel::before, .qopt:active::before, .qopt.touch-active::before{opacity:.42}
  .acc-item.open::before, .acc-item:active::before, .acc-item.touch-active::before{opacity:var(--photoO)}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>

<header class="site-head" id="siteHead">
  <div class="wrap">
    <a class="brand" href="#" aria-label="PrintPixel home">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="9" stroke="var(--accent)" stroke-width="2.5"/>
        <path d="M16 1v8M16 23v8M1 16h8M23 16h8" stroke="var(--accent)" stroke-width="2.5"/>
        <circle cx="16" cy="16" r="3" fill="var(--accent)"/>
      </svg>
      <span class="brand-name">PrintPixel <em>· DPI &amp; Print Analyzer</em></span>
    </a>
    <nav class="head-nav" aria-label="Page sections">
      <a href="#reference">Reference</a><a href="#learn">FAQ</a>
    </nav>
    <button class="icon-btn" id="themeBtn" aria-label="Switch color theme">
      <svg class="ic-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
      <svg class="ic-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8z"/></svg>
    </button>
  </div>
</header>

<main class="wrap">

  <section class="intro">
    <div class="intro-grid">
      <div class="intro-left">
        <p class="eyebrow">Free · Private · In-browser</p>
        <h1>Will this image print sharp?</h1>
        <p class="sub">Drop an image to see its true pixel size, whether it carries DPI info, and how large you can realistically print it. Nothing is ever uploaded.</p>
      </div>
      <aside class="proof" aria-label="Example of a result">
        <div class="proof-card">
          <div class="proof-head"><span class="proof-dot"></span> Sample result <span class="proof-stamp">PRINT-READY</span></div>
          <div class="proof-file">sunset-6000×4000.jpg</div>
          <div class="proof-line"><span class="lbl">Pixels</span><b>6,000 × 4,000</b></div>
          <div class="proof-line"><span class="lbl">DPI in file</span><b>— none (normal)</b></div>
          <div class="proof-ladder">
            <div class="pl"><span class="track"><i style="width:24%;background:var(--ok)"></i></span><span>20 × 13 in · photo</span></div>
            <div class="pl"><span class="track"><i style="width:48%;background:var(--warn)"></i></span><span>40 × 27 in · poster</span></div>
            <div class="pl"><span class="track"><i style="width:100%;background:var(--draft)"></i></span><span>83 × 56 in · distance</span></div>
          </div>
          <div class="proof-note">"Can I print it at 8 × 10?" → Yes, comfortably.</div>
        </div>
        <p class="proof-cap">what you'll see — before you upload anything</p>
      </aside>
    </div>
    <ol class="model dim-group" aria-label="How print resolution works">
      <li class="dim-item"><span class="n">1</span><div><b>Pixels are the detail</b><span>Fixed — no setting changes it.</span></div></li>
      <li class="dim-item"><span class="n">2</span><div><b>DPI is just a ruler</b><span>It packs pixels onto paper.</span></div></li>
      <li class="dim-item"><span class="n">3</span><div><b>Size = pixels ÷ DPI</b><span>Every image prints at many sizes.</span></div></li>
    </ol>
  </section>

  <section class="tool" id="tool" aria-label="Analyzer tool">
    <div class="tabs" role="tablist" aria-label="Tool modes">
      <button class="tab" role="tab" id="tab-analyze" aria-selected="true" aria-controls="panel-analyze" data-tab="analyze">
        <span class="idx">01</span> Analyze an image
      </button>
      <button class="tab" role="tab" id="tab-plan" aria-selected="false" aria-controls="panel-plan" data-tab="plan">
        <span class="idx">02</span> Plan a print <span class="hasimg" id="planDot" title="Image loaded"></span>
      </button>
    </div>

    <div class="panel on" id="panel-analyze" role="tabpanel" aria-labelledby="tab-analyze">
      <div id="idleState">
        <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Upload an image: drag and drop, paste, or browse">
          <span class="dz-photo" style="--img:url(/img/forest.jpg)" aria-hidden="true"></span>
          <i class="cm tl" aria-hidden="true"></i><i class="cm tr" aria-hidden="true"></i>
          <i class="cm bl" aria-hidden="true"></i><i class="cm br" aria-hidden="true"></i>
          <span class="dz-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.8" cy="8.8" r="1.7"/><path d="M21 15.5 16.5 11l-8 8.5"/></svg>
          </span>
          <span class="dz-title">Drop your image here</span>
          <span class="dz-sub"><span class="dz-sub-desk">or paste from the clipboard</span><span class="dz-sub-mob">or tap anywhere to browse device</span></span>
          <div class="dz-actions">
            <span class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Choose image
            </span>
            <button class="btn btn-ghost" id="sampleBtn" type="button">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
              See a sample result
            </button>
          </div>
          <span class="dz-out">You'll see: pixel size · DPI metadata · max print sizes · a verdict for your target</span>
          <span class="dz-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <span>Analyzed on this device · JPEG &amp; PNG get full DPI detection</span>
            <span class="cmyk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          </span>
        </div>
        <input type="file" id="fileInput" accept="image/*" class="sr-only" aria-hidden="true" tabindex="-1">
        <div id="errorBox" role="alert" aria-live="assertive"></div>
      </div>
      <div id="resultState" hidden aria-live="polite"></div>
    </div>

    <div class="panel" id="panel-plan" role="tabpanel" aria-labelledby="tab-plan" hidden>
      <div class="plan-grid">
        <div>
          <div class="field-lbl">Paper size</div>
          <div class="chips dim-group" id="presetChips"></div>
          <div class="dim-row">
            <div class="dim-field"><input id="dimW" type="number" min="0.5" max="400" step="0.1" value="8" aria-label="Print width"><span class="unit" id="unitW">in</span></div>
            <span class="dim-x" aria-hidden="true">×</span>
            <div class="dim-field"><input id="dimH" type="number" min="0.5" max="400" step="0.1" value="10" aria-label="Print height"><span class="unit" id="unitH">in</span></div>
            <button class="icon-btn" id="rotateBtn" title="Swap width and height" aria-label="Swap width and height">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            </button>
            <div class="seg" role="group" aria-label="Units">
              <button id="unitIn" class="sel">in</button><button id="unitCm">cm</button>
            </div>
          </div>
          <div class="field-lbl" style="margin-top:24px">Quality target</div>
          <div class="qgrid dim-group" id="qualityGrid"></div>
        </div>
        <div>
          <div class="plan-out">
            <div class="lbl">Pixels needed</div>
            <div class="need" id="needPx">—</div>
            <div class="meta" id="needMeta">—</div>
          </div>
          <div id="verdictBox"></div>
          <div class="disclaim">Guidance, not a guarantee — paper, viewing distance, subject matter and the printer itself all play a part.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="reference">
    <h2>Common print sizes, in pixels</h2>
    <div class="sec-head"><span class="k">03 · Reference</span></div>
    <p class="lede">What each popular size actually needs. “Use” sends the size straight to the planner above.</p>
    <div class="table-card"><div class="tbl-scroll">
      <table>
        <thead><tr><th scope="col">Size</th><th scope="col">At 300 DPI (photo)</th><th scope="col">At 150 DPI (poster)</th><th scope="col"></th></tr></thead>
        <tbody id="refBody" class="dim-group"></tbody>
      </table>
    </div></div>
  </section>

  <section class="block" id="learn">
    <h2>DPI, explained without the jargon</h2>
    <div class="sec-head"><span class="k">04 · Good to know</span></div>
    <p class="lede">The four questions people actually ask. Hover one — it quietly shows the print it&#8217;s talking about.</p>
    <div class="acc dim-group" id="acc"></div>
  </section>

</main>

<footer>
  <div class="wrap">
    <div>
      <div class="f-brand">
        <svg width="17" height="17" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="9" stroke="var(--accent)" stroke-width="2.5"/><path d="M16 1v8M16 23v8M1 16h8M23 16h8" stroke="var(--accent)" stroke-width="2.5"/><circle cx="16" cy="16" r="3" fill="var(--accent)"/></svg>
        PrintPixel
        <span class="cmyk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </div>
      <p style="margin-top:9px">Your image is analyzed directly in your browser. No uploads, no accounts, no tracking of your files.</p>
      <nav class="footer-nav" aria-label="Legal and information links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </nav>
    </div>
    <p style="max-width:36ch">Figures here are practical guidance for planning — for important jobs, always order a proof print first.</p>
  </div>
</footer>

<noscript><div style="padding:20px;text-align:center">This tool runs entirely in your browser and needs JavaScript enabled.</div></noscript>

<script is:inline>
'use strict';
const $ = (s, el=document) => el.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtInt = n => Math.round(n).toLocaleString('en-US');
const fmtDim = n => (Math.round(n*10)/10).toLocaleString('en-US',{maximumFractionDigits:1});
const MP = (w,h) => (w*h)/1e6;

const TIERS = [
  {dpi:300, name:'Photo quality', desc:'sharp, viewed up close',       varName:'--ok'},
  {dpi:150, name:'Good / poster', desc:'arm\u2019s length and beyond', varName:'--warn'},
  {dpi:72,  name:'Draft / large', desc:'viewed from a distance',       varName:'--draft'}
];
const QUALITIES = [
  {dpi:300, cap:'Photos, flyers, anything held in the hand'},
  {dpi:150, cap:'Posters, magazine spreads, canvas'},
  {dpi:72,  cap:'Large format seen from metres away'}
];
const PRESETS = [
  {id:'4x6',label:'4 × 6',w:4,h:6},{id:'5x7',label:'5 × 7',w:5,h:7},
  {id:'8x10',label:'8 × 10',w:8,h:10},{id:'a4',label:'A4',w:8.27,h:11.69},
  {id:'11x14',label:'11 × 14',w:11,h:14},{id:'16x20',label:'16 × 20',w:16,h:20},
  {id:'18x24',label:'18 × 24',w:18,h:24},{id:'24x36',label:'24 × 36',w:24,h:36},
  {id:'custom',label:'Custom',w:null,h:null}
];
const state = { img:null, plan:{ wIn:8, hIn:10, unit:'in', dpi:300, preset:'8x10' } };
try{ const p = JSON.parse(localStorage.getItem('ppi-prefs')||'null');
     if(p){ if(p.unit==='cm'||p.unit==='in') state.plan.unit=p.unit; if([300,150,72].includes(p.dpi)) state.plan.dpi=p.dpi; } }catch(e){}
const savePrefs = () => { try{ localStorage.setItem('ppi-prefs', JSON.stringify({unit:state.plan.unit,dpi:state.plan.dpi})); }catch(e){} };

/* ---------- DPI metadata parsers (local only) ---------- */
const sliceBuf = f => f.slice(0,262144).arrayBuffer().catch(()=>null);
const ascii = (dv,o,n) => { let s=''; for(let i=0;i<n;i++) s+=String.fromCharCode(dv.getUint8(o+i)); return s; };
function parsePngDpi(buf){ try{ const dv=new DataView(buf); if(dv.getUint32(0)!==0x89504E47) return null; let o=8;
  while(o+8<=dv.byteLength){ const len=dv.getUint32(o), t=ascii(dv,o+4,4);
    if(t==='pHYs'){ const x=dv.getUint32(o+8), u=dv.getUint8(o+16); return (u===1&&x>0)?Math.round(x*0.0254):null; }
    if(t==='IDAT'||t==='IEND') break; o+=12+len; } }catch(e){} return null; }
function parseExifDpi(dv,t){ try{ const le=dv.getUint16(t)===0x4949; const u16=o=>dv.getUint16(o,le), u32=o=>dv.getUint32(o,le);
  if(u16(t+2)!==0x002A) return null; const ifd=t+u32(t+4), n=u16(ifd); let xr=null,yr=null,unit=2;
  for(let i=0;i<n;i++){ const e=ifd+2+i*12, tag=u16(e), type=u16(e+2), vo=e+8;
    if(tag===0x011A||tag===0x011B){ let v; if(type===3)v=u16(vo); else if(type===4)v=u32(vo);
      else { const off=t+u32(vo), num=u32(off), den=u32(off+4); v=den?num/den:num; }
      if(tag===0x011A)xr=v; else yr=v; }
    if(tag===0x0128) unit=(type===3)?u16(vo):u32(vo); }
  if(!xr) return null; const v=(yr&&yr!==xr)?(xr+yr)/2:xr; return Math.round(unit===3?v*2.54:v); }catch(e){ return null; } }
function parseJpegDpi(buf){ try{ const dv=new DataView(buf); if(dv.getUint16(0)!==0xFFD8) return null; let o=2;
  while(o+4<=dv.byteLength){ if(dv.getUint8(o)!==0xFF) break; const m=dv.getUint8(o+1);
    if(m===0xDA) break; if(m===0xD8||m===0x01||(m>=0xD0&&m<=0xD9)){ o+=2; continue; }
    const segLen=dv.getUint16(o+2), s=o+4;
    if(m===0xE0&&ascii(dv,s,4)==='JFIF'){ const u=dv.getUint8(s+7), xd=dv.getUint16(s+8), yd=dv.getUint16(s+10);
      if(u===1&&xd>0) return Math.round((xd+yd)/2); if(u===2&&xd>0) return Math.round((xd+yd)/2*2.54); }
    if(m===0xE1&&ascii(dv,s,4)==='Exif'&&dv.getUint16(s+4)===0){ const r=parseExifDpi(dv,s+6); if(r) return r; }
    o+=2+segLen; } }catch(e){} return null; }

/* ---------- file handling ---------- */
const loadImg = url => new Promise((res,rej)=>{ const i=new Image(); i.onload=()=>res(i); i.onerror=()=>rej(new Error('decode')); i.src=url; });
const showError = m => { $('#errorBox').innerHTML = `<div class="err"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.2"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>${esc(m)}</span></div>`; };
const clearError = () => { $('#errorBox').innerHTML=''; };

async function handleFile(file){
  if(!file) return; clearError();
  const ok = /^image\//.test(file.type) || /\.(jpe?g|png|gif|webp|bmp|avif|jfif|tiff?)$/i.test(file.name||'');
  if(!ok){ showError('That doesn\u2019t look like an image file. Try a JPEG, PNG, WebP or GIF.'); return; }
  const url = URL.createObjectURL(file); let el;
  try{ el = await loadImg(url); }catch(e){ URL.revokeObjectURL(url);
    showError(/\.(hei[cf])$/i.test(file.name)
      ? 'This browser can\u2019t decode HEIC/HEIF yet. Export the photo as a JPEG and try again.'
      : 'Couldn\u2019t read that file \u2014 it may be corrupted or in a format this browser can\u2019t display.'); return; }
  let dpi=null;
  const isPng=file.type==='image/png'||/\.png$/i.test(file.name), isJpeg=file.type==='image/jpeg'||/\.(jpe?g|jfif)$/i.test(file.name);
  if(isPng||isJpeg){ const buf=await sliceBuf(file); if(buf) dpi=isPng?parsePngDpi(buf):parseJpegDpi(buf); }
  const w=el.naturalWidth,h=el.naturalHeight;
  state.img={w,h,name:file.name,size:file.size,mp:MP(w,h),url,dpi};
  renderAnalyze(); renderPlan(); updateDots();
  $('#idleState').hidden=true; $('#resultState').hidden=false;
  if(window.innerWidth<860) $('#resultState').scrollIntoView({behavior:'smooth',block:'start'});
}
function resetToIdle(clearImg){
  if(clearImg){ if(state.img) URL.revokeObjectURL(state.img.url); state.img=null; $('#resultState').innerHTML=''; renderPlan(); updateDots(); }
  $('#idleState').hidden=false; $('#resultState').hidden=true; $('#dropzone').focus();
}

/* ---------- analyze ---------- */
const aspectLabel=(w,h)=>{ const g=(a,b)=>b?g(b,a%b):a, d=g(w,h), rw=w/d, rh=h/d; return (rw<=32&&rh<=32)?`${rw}:${rh}`:`${(w/h).toFixed(2)}:1`; };
const fmtBytes=b=>b>=1048576?(b/1048576).toFixed(1)+' MB':Math.max(1,Math.round(b/1024))+' KB';
function renderAnalyze(){
  const im=state.img; if(!im) return;
  const maxLong=Math.max(im.w,im.h)/72;
  const rows=TIERS.map(t=>{ const wi=im.w/t.dpi, hi=im.h/t.dpi;
    const pct=Math.min(100,Math.max(6,(Math.max(wi,hi)/maxLong)*100));
    return `<div class="lrow dim-item" style="--tc:var(${t.varName})">
      <div class="ltier"><b>${t.name}</b><span>${t.dpi} DPI · ${t.desc}</span></div>
      <div class="lbar"><i data-w="${pct.toFixed(1)}"></i></div>
      <div class="lsize"><b>${fmtDim(wi)} × ${fmtDim(hi)} in</b><span>${fmtDim(wi*2.54)} × ${fmtDim(hi*2.54)} cm</span></div></div>`; }).join('');
  const dpiBadge=im.dpi
    ? `<span class="badge has"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>${im.dpi} DPI in file</span></span><div class="sub">metadata found</div>`
    : `<span class="badge none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>none found</span></span><div class="sub">perfectly normal</div>`;
  const hint=im.dpi?`<div class="hintline">At the file's own ${im.dpi} DPI hint this prints at ${fmtDim(im.w/im.dpi)} × ${fmtDim(im.h/im.dpi)} in — but any size above works.</div>`:'';
  const mw=im.w/300, mh=im.h/300;
  const lead=`<div class="res-lead">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
    <span>Prints up to <b>${fmtDim(mw)} × ${fmtDim(mh)} in</b> (${fmtDim(mw*2.54)} × ${fmtDim(mh*2.54)} cm) at photo quality — bigger if it\u2019ll be viewed from a distance.</span></div>`;
  const note=im.dpi
    ?`<div class="note info"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.2"/><path d="M12 11v5M12 7.6v.1"/></svg><span><b>What the ${im.dpi} DPI tag means:</b> just a printing suggestion saved by the app that made this file. Software can ignore it, and it doesn\u2019t change your pixels one bit — the sizes above are the real story.</span></div>`
    :`<div class="note info"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.2"/><path d="M12 11v5M12 7.6v.1"/></svg><span><b>No DPI saved in this file</b> — completely normal. Screenshots and most web images don\u2019t carry one. Nothing is wrong and no detail is missing; DPI only matters when you pick a physical print size below.</span></div>`;
  const bigNote=im.mp>=50?`<div class="note warn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2.5 20h19L12 3z"/><path d="M12 10v4M12 17v.1"/></svg><span><b>That\u2019s a very large image (~${fmtDim(im.mp)} MP).</b> The numbers are fine — just know some editing apps and print-shop software slow down with files this big.</span></div>`:'';
  $('#resultState').innerHTML=`
    <div class="res-head">
      <img class="thumb" src="${im.url}" alt="Preview of ${esc(im.name)}">
      <div class="res-file"><b title="${esc(im.name)}">${esc(im.name)}</b><span>${fmtBytes(im.size)} · analyzed locally</span></div>
      <div class="res-actions">
        <button class="btn btn-ghost" id="againBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
          Analyze another
        </button>
        <button class="icon-btn" id="removeBtn" title="Remove image" aria-label="Remove image"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
      </div>
    </div>
    ${lead}
    <div class="stat-grid dim-group">
      <div class="stat dim-item"><div class="lbl">Pixels</div><div class="val big">${fmtInt(im.w)} × ${fmtInt(im.h)}</div></div>
      <div class="stat dim-item"><div class="lbl">Megapixels</div><div class="val">${fmtDim(im.mp)} MP</div></div>
      <div class="stat dim-item"><div class="lbl">Aspect ratio</div><div class="val">${aspectLabel(im.w,im.h)}</div></div>
      <div class="stat dim-item stat-dpi"><div class="lbl">DPI in file</div>${dpiBadge}</div>
    </div>
    <div class="ladder"><h3>How large can it print?</h3>
      <p class="cap">Same pixels, three densities — bigger print, softer close-up. Touch or hover to compare.</p>
      <div class="dim-group">${rows}</div>${hint}</div>
    ${note}${bigNote}
    <div class="res-cta">
      <p>Have a specific size in mind — a frame, a poster, an A4 page? Check this image against it.</p>
      <button class="btn btn-primary" id="toPlanBtn">Plan a print size
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>`;
  requestAnimationFrame(()=>requestAnimationFrame(()=>{ $('#resultState').querySelectorAll('.lbar i').forEach(i=>{ i.style.width=i.dataset.w+'%'; }); }));
  $('#againBtn').onclick=()=>resetToIdle(false);
  $('#removeBtn').onclick=()=>resetToIdle(true);
  $('#toPlanBtn').onclick=()=>switchTab('plan');
}

/* ---------- plan ---------- */
const currentSizeIn=()=>{ const p=state.plan, f=v=>p.unit==='cm'?v/2.54:v; return {w:f(p.wIn),h:f(p.hIn)}; };
const sizeLabel=(w,h)=>state.plan.unit==='cm'?`${fmtDim(w*2.54)} × ${fmtDim(h*2.54)} cm`:`${fmtDim(w)} × ${fmtDim(h)} in`;
function renderPlan(){
  const {w,h}=currentSizeIn(), q=state.plan.dpi, Rw=w*q, Rh=h*q;
  $('#needPx').innerHTML=`${fmtInt(Rw)} × ${fmtInt(Rh)} <small>px</small>`;
  $('#needMeta').textContent=`${sizeLabel(w,h)} at ${q} DPI · ≈ ${fmtDim(MP(Rw,Rh))} MP`;
  const box=$('#verdictBox'), im=state.img;
  if(!im){ box.innerHTML=`<div class="noimg">No image loaded yet — add one to see if it\u2019s enough for this size.<br><button class="btn btn-ghost btn-sm" id="pickBtn">Choose image</button></div>`;
    $('#pickBtn').onclick=()=>{ switchTab('analyze'); $('#fileInput').click(); }; return; }
  const s=Math.max(Math.min(im.w/Rw,im.h/Rh), Math.min(im.w/Rh,im.h/Rw));
  const effDpi=Math.round(s*q);
  let tone,head,body,stamp;
  if(s>=1){ tone='var(--ok)'; head='Enough pixels — comfortably'; stamp='PRINT-READY';
    body=`At this size your image lands at roughly <b>${effDpi} DPI</b>${effDpi>q?' — above':' — meeting'} the ${q} DPI target. You have headroom to crop a little if needed.`; }
  else if(s>=0.66){ tone='var(--warn)'; head='Borderline — still workable'; stamp='BORDERLINE';
    body=`You\u2019d be upscaling by about <b>${Math.round((1/s-1)*100)}%</b> (effective ~${effDpi} DPI). Typically fine for a poster viewed at arm\u2019s length or more; it may soften up close.`; }
  else{ tone='var(--bad)'; head='Below the recommended resolution'; stamp='CHECK FIRST';
    body=`This size would give only ~<b>${effDpi} DPI</b> against a ${q} DPI target — expect visible softness. Consider a smaller print, a lower quality target, or a higher-resolution file.`; }
  const asp=Math.abs(im.w/im.h-w/h)>0.035?` Note: the image\u2019s aspect ratio (${aspectLabel(im.w,im.h)}) differs from this page — fitting will crop it, or leave borders.`:'';
  const pct=(Math.min(s,1.5)/1.5*100).toFixed(1);
  box.innerHTML=`
    <div class="imgchip">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.8" cy="8.8" r="1.7"/><path d="M21 15.5 16.5 11l-8 8.5"/></svg>
      <div><b>${esc(im.name)}</b><div class="mono">${fmtInt(im.w)} × ${fmtInt(im.h)} px</div></div>
      <button class="chg" id="changeImg">change</button>
    </div>
    <div class="verdict" style="--tone:${tone}">
      <span class="stamp">${stamp}</span>
      <div class="v-head">${head}</div>
      <div class="v-body">${body}</div>
      <div class="gauge" aria-hidden="true"><i id="gaugeFill" data-w="${pct}"></i><span class="mk" style="left:44%"></span><span class="mk" style="left:66.7%"></span></div>
      <div class="gauge-lbls" aria-hidden="true"><span>0</span><span>workable ≈</span><span>recommended</span></div>
      <div class="v-sub">Comparing ${sizeLabel(w,h)} at ${q} DPI against your loaded image.${asp}</div>
    </div>`;
  requestAnimationFrame(()=>requestAnimationFrame(()=>{ const f=$('#gaugeFill'); if(f) f.style.width=f.dataset.w+'%'; }));
  $('#changeImg').onclick=()=>{ switchTab('analyze'); resetToIdle(false); };
}
const updateDots=()=>$('#planDot').classList.toggle('on',!!state.img);

/* ---------- controls ---------- */
function buildPresets(){
  $('#presetChips').innerHTML=PRESETS.map(p=>`<button class="chip dim-item ${state.plan.preset===p.id?'sel':''}" data-id="${p.id}">${p.label}</button>`).join('');
  $('#presetChips').querySelectorAll('.chip').forEach(c=>c.onclick=()=>{ const p=PRESETS.find(x=>x.id===c.dataset.id);
    state.plan.preset=p.id;
    if(p.w!==null){ state.plan.wIn=state.plan.unit==='cm'?Math.round(p.w*2.54*10)/10:p.w; state.plan.hIn=state.plan.unit==='cm'?Math.round(p.h*2.54*10)/10:p.h; }
    syncDimInputs(); buildPresets(); renderPlan(); });
}
function buildQualities(){
  $('#qualityGrid').innerHTML=QUALITIES.map(q=>`<button class="qopt dim-item ${state.plan.dpi===q.dpi?'sel':''}" data-tier="${q.dpi}" data-dpi="${q.dpi}" style="--img:url(/img/fern.jpg)"><b>${q.dpi} DPI</b><span>${q.cap}</span></button>`).join('');
  $('#qualityGrid').querySelectorAll('.qopt').forEach(b=>b.onclick=()=>{ state.plan.dpi=+b.dataset.dpi; savePrefs(); buildQualities(); renderPlan(); });
}
function syncDimInputs(){ $('#dimW').value=state.plan.wIn; $('#dimH').value=state.plan.hIn; $('#unitW').textContent=$('#unitH').textContent=state.plan.unit; }
function onDimInput(){ const w=parseFloat($('#dimW').value), h=parseFloat($('#dimH').value);
  if(!isNaN(w)&&w>0) state.plan.wIn=w; if(!isNaN(h)&&h>0) state.plan.hIn=h;
  state.plan.preset='custom'; buildPresets(); renderPlan(); }
$('#dimW').addEventListener('input',onDimInput); $('#dimH').addEventListener('input',onDimInput);
$('#rotateBtn').onclick=()=>{ const t=state.plan.wIn; state.plan.wIn=state.plan.hIn; state.plan.hIn=t; syncDimInputs(); renderPlan(); };
$('#unitIn').onclick=()=>setUnit('in'); $('#unitCm').onclick=()=>setUnit('cm');
function setUnit(u){ if(state.plan.unit===u) return;
  const c=u==='cm'?v=>Math.round(v*2.54*10)/10:v=>Math.round(v/2.54*10)/10;
  state.plan.wIn=c(state.plan.wIn); state.plan.hIn=c(state.plan.hIn); state.plan.unit=u;
  $('#unitIn').classList.toggle('sel',u==='in'); $('#unitCm').classList.toggle('sel',u==='cm');
  savePrefs(); syncDimInputs(); renderPlan(); }
function switchTab(n){
  document.querySelectorAll('.tab').forEach(t=>t.setAttribute('aria-selected',String(t.dataset.tab===n)));
  $('#panel-analyze').hidden=n!=='analyze'; $('#panel-analyze').classList.toggle('on',n==='analyze');
  $('#panel-plan').hidden=n!=='plan'; $('#panel-plan').classList.toggle('on',n==='plan');
  if(n==='plan') renderPlan();
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>switchTab(t.dataset.tab));

/* ---------- dropzone / paste / sample ---------- */
const dz=$('#dropzone'), fi=$('#fileInput');
dz.addEventListener('click',e=>{ if(!e.target.closest('#sampleBtn')) fi.click(); });
dz.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); fi.click(); } });
fi.addEventListener('change',()=>{ handleFile(fi.files[0]); fi.value=''; });
['dragover','dragenter'].forEach(ev=>dz.addEventListener(ev,e=>{ e.preventDefault(); dz.classList.add('drag'); }));
['dragleave','dragend'].forEach(ev=>dz.addEventListener(ev,()=>dz.classList.remove('drag')));
dz.addEventListener('drop',e=>{ e.preventDefault(); dz.classList.remove('drag'); handleFile(e.dataTransfer.files[0]); });
document.addEventListener('dragover',e=>e.preventDefault()); document.addEventListener('drop',e=>e.preventDefault());
window.addEventListener('paste',e=>{ const f=Array.from((e.clipboardData&&e.clipboardData.files)||[]).find(f=>f.type.indexOf('image/')===0); if(f){ switchTab('analyze'); handleFile(f); } });
$('#sampleBtn').addEventListener('click',async e=>{ e.stopPropagation();
  try{
    const res=await fetch('/img/sample.jpg');
    if(!res.ok) throw new Error('fetch failed');
    const b=await res.blob();
    handleFile(new File([b],'botanical-fine-art-sample.jpg',{type:'image/jpeg'}));
  }catch(err){
    try{
      const res2=await fetch('/img/fern.jpg');
      const b2=await res2.blob();
      handleFile(new File([b2],'botanical-fine-art-sample.jpg',{type:'image/jpeg'}));
    }catch(err2){ console.error(err2); }
  }
});

/* ---------- reference table ---------- */
$('#refBody').innerHTML=PRESETS.filter(p=>p.id!=='custom').map(p=>{
  const at=d=>{ const w=p.w*d,h=p.h*d; return `${fmtInt(w)} × ${fmtInt(h)}<small>· ≈ ${fmtDim(MP(w,h))} MP</small>`; };
  return `<tr class="dim-item"><td class="size">${p.label}</td><td class="px">${at(300)}</td><td class="px">${at(150)}</td><td><button class="use-btn" data-id="${p.id}">Use</button></td></tr>`; }).join('');
$('#refBody').querySelectorAll('.use-btn').forEach(b=>b.onclick=()=>{ const p=PRESETS.find(x=>x.id===b.dataset.id);
  state.plan.preset=p.id;
  state.plan.wIn=state.plan.unit==='cm'?Math.round(p.w*2.54*10)/10:p.w;
  state.plan.hIn=state.plan.unit==='cm'?Math.round(p.h*2.54*10)/10:p.h;
  syncDimInputs(); buildPresets(); renderPlan(); switchTab('plan');
  $('#tool').scrollIntoView({behavior:'smooth',block:'start'}); });

/* ---------- FAQ with cursor spotlight across question & answer ---------- */
const QA=[
 {img:'/img/loupe.jpg', q:'DPI or PPI — which is it?',
  a:'PPI (pixels per inch) describes the digital file; DPI (dots per inch) describes ink on paper. In everyday talk they get mixed up constantly, and this tool treats “DPI” as pixels-per-inch-of-print. When someone says “a 300 DPI image,” what they really mean is <em>“300 pixels for every inch of paper.”</em>'},
 {img:'/img/gallery.jpg', q:'My image says 72 DPI. Is it low quality?',
  a:'No. That number is metadata — a suggestion about print size, not a measure of detail. A 6000 × 4000 photo tagged “72 DPI” has <em>exactly the same detail</em> as one tagged “300 DPI.” The 72 convention is a leftover from early computer screens. Judge images by pixel dimensions, not by that tag.'},
 {img:'/img/poster.jpg', q:'How many DPI do I actually need?',
  a:'It depends on viewing distance. Hand-held items (photos, flyers): 300. Posters seen at arm\u2019s length: 100–150. Large format viewed from metres away: 72–100. Doubling the print size halves the effective DPI — which is why the analyzer shows all three tiers side by side.'},
 {img:'/img/prints.jpg', q:'Why do social-media photos print poorly?',
  a:'Platforms recompress and shrink uploads to save bandwidth — usually to around 1080 pixels wide. That looks fine on a phone, but 1080 px at 300 DPI is only 3.6 inches. For prints, use the <em>original file</em> from your camera or gallery app, not the copy you downloaded from the web.'}
];
$('#acc').innerHTML=QA.map((x,i)=>`
  <div class="acc-item dim-item" style="--img:url(${x.img})">
    <button class="acc-btn" aria-expanded="false" aria-controls="accb${i}">
      <span class="qn">Q${i+1}</span>${x.q}
      <span class="pm" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg></span>
    </button>
    <div class="acc-body" id="accb${i}"><p>${x.a}</p></div>
  </div>`).join('');
$('#acc').querySelectorAll('.acc-item').forEach(item=>{
  const btn=item.querySelector('.acc-btn'), body=item.querySelector('.acc-body');
  btn.addEventListener('click',()=>{ const open=item.classList.toggle('open');
    btn.setAttribute('aria-expanded',String(open));
    body.style.maxHeight=open?body.scrollHeight+'px':'0px'; });
  /* cursor and touch spotlight tracking across the entire question & answer */
  const setPt=(x,y)=>{ const r=item.getBoundingClientRect();
    item.style.setProperty('--mx',(x-r.left)+'px'); item.style.setProperty('--my',(y-r.top)+'px'); };
  item.addEventListener('pointermove',e=>setPt(e.clientX,e.clientY));
  item.addEventListener('pointerdown',e=>setPt(e.clientX,e.clientY));
  item.addEventListener('touchmove',e=>{ if(e.touches&&e.touches[0]) setPt(e.touches[0].clientX,e.touches[0].clientY); },{passive:true});
});
window.addEventListener('resize',()=>{ document.querySelectorAll('.acc-item.open .acc-body').forEach(b=>{ b.style.maxHeight=b.scrollHeight+'px'; }); });

/* ---------- mobile touch spotlight ---------- */
document.addEventListener('touchstart',e=>{
  const el=e.target.closest('.dim-item');
  if(el){
    document.querySelectorAll('.dim-item.touch-active').forEach(i=>i.classList.remove('touch-active'));
    el.classList.add('touch-active');
  }
},{passive:true});
document.addEventListener('touchend',()=>{
  setTimeout(()=>{
    document.querySelectorAll('.dim-item.touch-active').forEach(i=>i.classList.remove('touch-active'));
  },350);
},{passive:true});
document.addEventListener('touchcancel',()=>{
  document.querySelectorAll('.dim-item.touch-active').forEach(i=>i.classList.remove('touch-active'));
},{passive:true});

/* ---------- lazy images + title lines ---------- */
const lazyIO=new IntersectionObserver(es=>es.forEach(en=>{ if(en.isIntersecting){ const el=en.target;
  el.style.setProperty('--img',`url(${el.dataset.img})`); lazyIO.unobserve(el); } }),{rootMargin:'200px'});
document.querySelectorAll('[data-img]').forEach(el=>{ if(!el.style.getPropertyValue('--img')) lazyIO.observe(el); });
const revIO=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('rev'); revIO.unobserve(e.target); } }),{threshold:.4});
document.querySelectorAll('section.block h2').forEach(h=>revIO.observe(h));

/* ---------- scroll elevation & theme ---------- */
const head = $('#siteHead');
const onScroll = () => head.classList.toggle('scrolled', window.scrollY > 8);
onScroll(); window.addEventListener('scroll', onScroll, {passive:true});

$('#themeBtn').onclick=()=>{ const n=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=n; try{ localStorage.setItem('ppi-theme',n); }catch(e){} };

/* ---------- init ---------- */
$('#unitIn').classList.toggle('sel',state.plan.unit==='in');
$('#unitCm').classList.toggle('sel',state.plan.unit==='cm');
buildPresets(); buildQualities(); syncDimInputs(); renderPlan();
</script>
</body>
</html>
